GEMMA_SERVER_NAME=Sinan's Mac
GEMMA_API_TOKEN=gemma-demo

# Any OpenAI-compatible vLLM endpoint. Keep /v1 in the URL.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=
VLLM_MODEL=mlx-community/gemma-4-e4b-it-4bit

# Set true to test the complete iPhone -> Mac path without loading a model.
GEMMA_MOCK_MODE=false
